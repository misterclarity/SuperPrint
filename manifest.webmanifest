{
  "name": "SuperPrint — Coloring Pages",
  "short_name": "SuperPrint",
  "description": "Endless original coloring pages, drawn in your browser and printable at home. Works offline.",
  "id": "./",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#f6f2ea",
  "theme_color": "#f6f2ea",
  "lang": "en",
  "dir": "ltr",
  "categories": ["entertainment", "graphics", "lifestyle"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "New design",
      "short_name": "Create",
      "description": "Open the studio on a fresh page",
      "url": "studio.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Gallery",
      "short_name": "Gallery",
      "description": "A fresh batch of designs",
      "url": "gallery.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Saved designs",
      "short_name": "Saved",
      "description": "Designs you have kept",
      "url": "saved.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
